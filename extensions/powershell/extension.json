{
  "id": "buraq.powershell",
  "name": "PowerShell",
  "version": "1.0.0",
  "description": "PowerShell language support with syntax highlighting and script execution",
  "author": "BizAura",
  "icon": ":/icons/languages/powershell.svg",
  "languages": [
    {
      "id": "powershell",
      "name": "PowerShell",
      "extensions": ["ps1", "psm1", "psd1"],
      "highlighter": "powershell",
      "icon": ":/icons/languages/powershell.svg"
    }
  ],
  "runner": {
    "command": "pwsh -File \"${file}\"",
    "windowsCommand": "& \"${file}\"",
    "workingDirectory": "${fileDir}"
  }
}
