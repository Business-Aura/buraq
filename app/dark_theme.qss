/*
 * Modern Frameless Dark Theme for Buraq IDE
 * Background Depth Hierarchy:
 * - Base / Activity Bar / Title Bar: #181818
 * - Drawer / Sidebar:               #1f1f1f
 * - Editor & Terminal:               #1e1e1e
 * - Surface / Dialogs / Menus:       #252526
 * - Hairline Borders:                #2b2b2b
 * - Accent:                          #00BCD4 (Cyan) / #2196F3 (Blue)
 */

/* General Application Colors & Typography */
QWidget, QDialog {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: "Segoe UI", "Inter", -apple-system, BlinkMacSystemFont, "Roboto", Arial, sans-serif;
    font-size: 9.5pt;
}

/* Outer Window Frame */
QWidget#Frame {
    background-color: #181818;
    border: 1px solid #2b2b2b;
}

QWidget#centralDiv {
    width: 100%;
    background-color: #1e1e1e;
}

/* Base Panel Layout Containers */
QWidget#customTitleBar,
QWidget#secondaryTitleBar {
    background-color: #181818;
    border-bottom: 1px solid #262626;
}

QWidget#topPanel {
    background-color: #181818;
    border-bottom: 1px solid #262626;
}

QWidget#leftPanel {
    background-color: #181818;
    border-right: 1px solid #262626;
}

QWidget#rightPanel {
    background-color: #181818;
    border-left: 1px solid #262626;
}

QWidget#bottomPanel {
    background-color: #181818;
    border-top: 1px solid #262626;
}

/* Sidebar Custom Drawer */
CustomDrawer, QWidget#CustomDrawer {
    background-color: #1f1f1f;
    border: none;
}

/* Modern TreeView in Explorer */
QTreeView {
    background-color: #1f1f1f;
    color: #cccccc;
    border: none;
    outline: none;
    font-size: 9.5pt;
    show-decoration-selected: 0;
}

QTreeView::item {
    padding: 3px 6px;
    min-height: 22px;
    border-radius: 4px;
    margin: 1px 4px;
}

QTreeView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

QTreeView::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QTreeView::item:selected:hover {
    background-color: #0e5687;
    color: #ffffff;
}

/* Branch indicators */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/ui/chevron_right.svg);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    border-image: none;
    image: url(:/icons/ui/chevron_down.svg);
}

/* Hairline Splitters */
QSplitter {
    background-color: transparent;
}

QSplitter::handle {
    background-color: #262626;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #00BCD4;
}

/* Left Activity Bar Buttons */
QPushButton#folderButton,
QPushButton#outputConsoleButton {
    background-color: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0px;
    padding: 0px;
    color: #858585;
}

QPushButton#folderButton:hover,
QPushButton#outputConsoleButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QPushButton#folderButton[active="true"],
QPushButton#outputConsoleButton[active="true"] {
    border-left: 2px solid #00BCD4;
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.04);
}

/* Window Control Buttons (Title Bar) */
QPushButton#minimizeButton,
QPushButton#maximizeButton,
QPushButton#settingGearButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    color: #cccccc;
}

QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover,
QPushButton#settingGearButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#minimizeButton:pressed,
QPushButton#maximizeButton:pressed,
QPushButton#settingGearButton:pressed {
    background-color: rgba(255, 255, 255, 0.15);
}

QPushButton#closeButton {
    background-color: transparent;
    border: none;
    border-radius: 0px;
    padding: 0px;
    color: #cccccc;
}

QPushButton#closeButton:hover {
    background-color: #E81123;
    color: #ffffff;
}

QPushButton#closeButton:pressed {
    background-color: #BA101D;
    color: #ffffff;
}

/* Title Bar Typography */
QLabel#titleText {
    color: #cccccc;
    font-size: 9.5pt;
    font-weight: 600;
    margin-left: 4px;
}

QLabel#versionText {
    color: #888888;
    font-size: 8pt;
    padding: 1px 6px;
    background-color: #222222;
    border-radius: 3px;
    margin-left: 6px;
}

/* Explorer Header */
QLabel#HeaderLabel {
    color: #909090;
    font-size: 8pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding-left: 4px;
}

QPushButton#AddFolder,
QPushButton#CloseWorkspace {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    padding: 3px;
}

QPushButton#AddFolder:hover,
QPushButton#CloseWorkspace:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* Toolbar & Action Menus */
QToolBar {
    background-color: #181818;
    border: none;
    border-bottom: 1px solid #262626;
    padding: 2px 4px;
    spacing: 4px;
}

QPushButton#fileMenuButton,
QPushButton#buildMenuButton,
QPushButton#buildConfigMenuButton {
    background-color: transparent;
    color: #cccccc;
    border: none;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 9.5pt;
}

QPushButton#fileMenuButton:hover,
QPushButton#buildMenuButton:hover,
QPushButton#buildConfigMenuButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QPushButton#fileMenuButton:pressed,
QPushButton#buildMenuButton:pressed,
QPushButton#buildConfigMenuButton:pressed {
    background-color: rgba(255, 255, 255, 0.14);
}

/* Menus (QMenu) */
QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 5px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 3px;
    margin: 1px 4px;
}

QMenu::item:selected {
    background-color: #094771;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #3c3c3c;
    margin: 4px 6px;
}

/* Editor & Gutter */
QWidget#Editor {
    background-color: #1e1e1e;
    border: none;
    border-radius: 0px;
}

QPlainTextEdit#InternalPlainTextEdit {
    background-color: #1e1e1e;
    color: #d4d4d4;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 10.5pt;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QWidget#EditorMargin {
    background-color: #1e1e1e;
    border: none;
}

/* CodeRunner Button */
QPushButton#CodeRunner {
    background-color: transparent;
    border: none;
    border-radius: 3px;
    padding: 0px;
}

QPushButton#CodeRunner:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* Status Bar */
QStatusBar#appStatusBar, QStatusBar {
    background-color: #181818;
    color: #999999;
    border-top: 1px solid #262626;
    font-size: 9pt;
}

/* Minimalist Overlay Scrollbars */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.16);
    min-height: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.32);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.16);
    min-width: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.32);
}

QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 0.45);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0px;
}

/* General Buttons */
QPushButton {
    background-color: rgba(255, 255, 255, 0.06);
    color: #cccccc;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 9.5pt;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: #444444;
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.16);
}

QPushButton#PrimaryButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
}

QPushButton#PrimaryButton:hover {
    background-color: #0098ff;
}

QPushButton#PrimaryButton:pressed {
    background-color: #0066aa;
}

/* Settings Dialog Visual Differentiation */
QDialog#SettingsDialog QWidget#Frame {
    border: 1px solid #00BCD4;
    background-color: #252526;
}

QDialog#SettingsDialog QWidget#secondaryTitleBar {
    background-color: #1e1e1e;
    border-bottom: 1px solid #333333;
}

/* Tab Widget & Bar Flat Styling */
QTabWidget::pane {
    border: 1px solid #333333;
    background-color: #252526;
}

QTabBar::tab {
    background-color: #1e1e1e;
    color: #999999;
    padding: 7px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background-color: #252526;
    color: #ffffff;
}

QTabBar::tab:selected {
    border-bottom: 2px solid #00BCD4;
}

/* ── Integrated Terminal ── */
QTabWidget#BottomPanel::pane {
    border: none;
    border-top: 1px solid #262626;
    background-color: #1e1e1e;
}

QTabWidget#BottomPanel > QTabBar::tab {
    background-color: #181818;
    color: #858585;
    padding: 4px 14px;
    font-size: 9pt;
    border: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    margin-right: 2px;
    min-width: 70px;
}

QTabWidget#BottomPanel > QTabBar::tab:selected {
    background-color: #1e1e1e;
    color: #ffffff;
    border-top: 2px solid #00BCD4;
}

QTabWidget#BottomPanel > QTabBar::tab:hover:!selected {
    background-color: #222222;
    color: #cccccc;
}

QTextEdit#TerminalDisplay {
    background-color: #1e1e1e;
    color: #cccccc;
    border: none;
    font-family: "Cascadia Code", "Consolas", "Courier New", monospace;
    font-size: 10pt;
    padding: 4px 6px;
    selection-background-color: #264f78;
    selection-color: #ffffff;
}

QPushButton#NewTerminalButton {
    background-color: transparent;
    color: #858585;
    border: none;
    border-radius: 3px;
    font-size: 13pt;
    font-weight: bold;
    padding: 0px;
}

QPushButton#NewTerminalButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

QPushButton#TerminalCloseButton {
    background-color: transparent;
    color: #858585;
    border: none;
    border-radius: 2px;
    font-size: 8pt;
    padding: 0px;
    margin: 0px;
}

QPushButton#TerminalCloseButton:hover {
    background-color: #E81123;
    color: #ffffff;
}
